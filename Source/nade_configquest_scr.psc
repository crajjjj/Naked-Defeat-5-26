Function StartDefeat()				;#StartDefeat()
			
	;GUIDE: This should be the primary StartingPoint for Defeat. We should change all Entry Points to this eventually.		
		
	if !SPE_Actor.IsActorCalmed(PlayerRef)	
	NymTrace("StartDefeat() Actor was NOT calmed")
	SPE_Actor.SetActorCalmed(PlayerRef, true)
	endif
			
	Debug.trace ("NAKED DEFEAT configquest: StartDefeat()")
	bool WasRagdolling = false
	
	int Cowntdown = 6
	
	while Ragdolling && (Cowntdown > 0)		;#ragdoll
	WasRagdolling = true
	Debug.trace ("NAKED DEFEAT configquest: RAGDOLLING AA")		;#doll
	Utility.Wait(1.0)
	Cowntdown -= 1
	
		if (Cowntdown == 0) && Ragdolling
		PlayerRef.PushActorAway(PlayerRef, 0.1)
		;PlayerRef.MoveTo(PlayerRef)
		;PlayerRef.PushActorAway(PlayerRef, 0.1)
		endif 
	endwhile
	
	if WasRagdolling
	Utility.Wait(4.0)
	endif 
	
	;while Ragdolling	
	;WasRagdolling = true
	
	;Utility.Wait(1.0)
	;endwhile

	while Ragdolling && (Cowntdown > 0)		
	WasRagdolling = true
	Debug.trace ("NAKED DEFEAT configquest: RAGDOLLING BB")		;#doll
	Utility.Wait(1.0)
	Cowntdown -= 1
	
		if (Cowntdown == 0) && Ragdolling
		PlayerRef.PushActorAway(PlayerRef, 0.1)
		;PlayerRef.MoveTo(PlayerRef)
		;PlayerRef.PushActorAway(PlayerRef, 0.1)
		endif 
		
	endwhile

;	if HealthBoost
;	PlayerRef.ModActorValue("health", 100000.0)
;	endIf
	
	SendModEvent("Moan")
	
	int End = 5
	while (End > 0) && PlayerRef.IsWeaponDrawn() 
	PlayerRef.SheatheWeapon() 
	Utility.Wait(1.0)
	End -= 1
	endWhile
		
	NymTrace("Immobilize(true) for StartDefeat()")
	Immobilize(true)


	if IsDDScenario()
	
	calmqst.PlayPoseOnActor(PlayerRef, "Offering", false)
	Utility.Wait(3.0)
	else
	 
	calmqst.PlayPoseOnActor(PlayerRef, "Offering", false)
	 
	Utility.Wait(3.0)
	endif	

	if FollowerCount > 0
	folidle01.StartFollowerIdleQuest_01("none")
	folidle01.StartDoingNothing_01(true)
		if FollowerCount > 1
		folidle01.StartDoingNothing_02(true)
		endif
		if FollowerCount > 2	
		folidle01.StartDoingNothing_03(true)
		endif
		if FollowerCount > 3
		folidle01.StartDoingNothing_04(true)
		endif						
	endif

	SendModEvents(true)

	;>>>>>>>>>>>>>>>>>> DAR compatibility >>>>>>>>>>>>>>>>>>
	if !PlayerRef.IsInFaction(nade_DefeatFaction)
	PlayerRef.AddToFaction(nade_DefeatFaction)
	endif
	;<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<<
	
	if DefeatEntranceVia == "empty"
		 if Nym()
		 Debug.Messagebox("DefeatEntranceVia == empty")
		 DefeatEntranceVia = "StartDefeat(empty)"
		 endif
	endif 
	
	SendModEvent("Moan")
	NymTrace("CalmQuest.Start 1512")	
	CalmQuest.Start()

	
	
	
EndFunction

