Int Function AddQuestStageOption(String txt, Quest qst)
	Int i = qst.GetStage()
	if (i > 0) && (i < 1000)
		return AddTextOption(txt, i)
	else
		return AddTextOption(txt, i, OPTION_FLAG_DISABLED)
	endif
EndFunction

