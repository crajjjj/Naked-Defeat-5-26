Function UnequipSpell(Int hand)

    Spell equippedSpell = PlayerRef.GetEquippedSpell(hand)
    If equippedSpell
        PlayerRef.UnequipSpell(equippedSpell, hand)
        ShowDebugNotification("You lose focus on your " + equippedSpell.GetName() + " spell")
    EndIf
    
EndFunction

