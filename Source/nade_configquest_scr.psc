int lastINT = 0

int Function Random()

int BaseInt = Utility.RandomInt(1, 100)
int ModInt = (Utility.RandomFloat(-1,-50) as int)

int FinalInt
if lastINT == 0
FinalInt = BaseInt
elseif BaseInt == lastINT
FinalInt = BaseInt + ModInt 
elseif Utility.RandomInt(1,30) > 15
FinalInt = BaseInt + ModInt
endif

if FinalInt > 100
FinalInt == 100 - ModInt
elseif FinalInt < 1
FinalInt == 51 - ModInt
endIf

InfoMessage("FinalInt: "+FinalInt)
return FinalInt

EndFunction

