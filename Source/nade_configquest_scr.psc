                AmbushType3 = "Sabrecats"
                j = 1
            elseif i == 4
                AmbushType1 = "Boars"
                AmbushType2 = "Boars"
                AmbushType3 = "Boars"
                j = 1
            elseif i == 5
                AmbushType1 = "Bears"
                j = 1
            endif
        elseif AmbushType == "Skeevers"
