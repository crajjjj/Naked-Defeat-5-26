					DebugTrace("ItemRobbed: "+ItemName)
					endif
					
				EndWhile
				NymTrace("PlayerRef.QueueNiNodeUpdate(cfqgst 5382")
				PlayerRef.QueueNiNodeUpdate()
				
			;>>>> ROB GOLD ONLY >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>  	
						
			else 		

				if Gold > 1000
				GoldMin = 1000
				else
				GoldMin == Gold
				endif
				
				if Gold > 0
				RobbedGold = Utility.RandomInt(GoldMin,Gold)
				PlayerRef.RemoveItem(Gold001, RobbedGold, True, akRobber)
