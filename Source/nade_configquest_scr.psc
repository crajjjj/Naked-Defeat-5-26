;cfgqst.PlayerPosing("Struggle", cfgqst.DefeatTypeScenario, false)
		
	int NewPosePlayer	
	string NewTypePlayer
	
	;RANDOMIZE when (Type == "Random")
	if Type == "Random"
		if D100(50)
		Type = "Struggle"
		else
		Type = "Wait"
		endIf
	endif	
	
	;repeat the last used POSE
	if restore
	NewTypePlayer = LastTypePlayer
