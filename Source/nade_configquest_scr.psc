			Int iFormCount
			Form RobbedItem
			
			String ItemName
	
				;RobbedGold = Utility.RandomInt(GoldMin,Gold)
				;OLD: PlayerRef.RemoveItem(Gold001, RobbedGold, True, akRobber)			
				PlayerRef.RemoveItem(Gold001, Gold, True, akRobber)		
				RobbedGold = Gold 
